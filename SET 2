# 111. The "Command-Response" Pattern (Blocking)
# Send command, wait for specific ACK.
def send_command_sync(cmd):
    ser.write(f"{cmd}\n".encode())
    start = time.time()
    while time.time() - start < 1.0: # 1s Timeout
        if ser.in_waiting:
            resp = ser.readline().decode().strip()
            if resp == "ACK": return True
            if resp == "NACK": return False
    return False # Timeout

