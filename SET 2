# 116. The "Back-Off" Retrier
# If send fails, wait longer each time.
def send_with_retry(msg):
    delay = 0.1
    for _ in range(3):
        ser.write(msg)
        if wait_for_ack(): return True
        time.sleep(delay)
        delay *= 2 # Exponential backoff
    return False

