# 104. Drift Compensation (Integral Term)
# Corrects accumulated timing error over hours.
target_dt = 0.01
error_accum = 0
last_time = time.monotonic()

while True:
    now = time.monotonic()
    dt = now - last_time
    last_time = now
    
    error_accum += (target_dt - dt)
    
    # Run Physics/Control
    
    # Sleep corrected amount
    sleep_time = target_dt + error_accum
    if sleep_time > 0: time.sleep(sleep_time)

