# 101. The "Super Loop" Scheduler (Basic)
# A single loop that divides time slots based on modulo math.
# Simple, but can jitter if one task takes too long.
tick = 0
while True:
    start = time.monotonic()
    
    # 100Hz Task (Every tick)
    read_imu()
    
    # 10Hz Task (Every 10th tick)
    if tick % 10 == 0:
        update_pid_gains()
        
    # 1Hz Task (Every 100th tick)
    if tick % 100 == 0:
        blink_status_led()
        tick = 0 # Reset to prevent overflow (optional in Py, good for C++)
    
    tick += 1
    # Sleep remaining time for 100Hz (0.01s)
    time.sleep(max(0, 0.01 - (time.monotonic() - start)))

# 102. The "Priority Class" Scheduler (Object-Oriented)
# Better for managing complex systems.
class Task:
    def __init__(self, interval_ms, func):
        self.interval = interval_ms / 1000.0
        self.func = func
        self.next_run = 0

tasks = [
    Task(10,  read_imu),       # 100Hz
    Task(100, update_telemetry), # 10Hz
    Task(1000, check_battery)    # 1Hz
]

while True:
    now = time.monotonic()
    for t in tasks:
        if now >= t.next_run:
            t.func()
            t.next_run = now + t.interval
    time.sleep(0.001) # Short sleep to prevent 100% CPU usage

