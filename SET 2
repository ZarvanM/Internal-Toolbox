# 113. Binary Packet Structure (Header/Footer)
# Robust against noise. Structure: [0xAA, 0x55, LEN, DATA..., CS]
def send_binary_packet(data_bytes):
    header = b'\xAA\x55'
    length = bytes([len(data_bytes)])
    checksum = bytes([sum(data_bytes) % 256])
    packet = header + length + data_bytes + checksum
    ser.write(packet)

