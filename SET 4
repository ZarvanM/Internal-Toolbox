# 191. PID Controller Class (The Real Deal)
# Includes Integral Windup Guard and Output Clamping.
class PID:
    def __init__(self, kp, ki, kd, out_min=-1, out_max=1):
        self.kp, self.ki, self.kd = kp, ki, kd
        self.min, self.max = out_min, out_max
        self.integral = 0
        self.prev_err = 0

    def compute(self, setpoint, actual, dt):
        err = setpoint - actual
        
        # P Term
        p_out = self.kp * err
        
        # I Term (with clamp)
        self.integral += err * dt
        # Anti-windup: Stop integrating if we are maxed out
        i_out = self.ki * self.integral
        
        # D Term
        derivative = (err - self.prev_err) / dt
        d_out = self.kd * derivative
        
        self.prev_err = err
        
        # Sum and Clamp
        output = p_out + i_out + d_out
        return max(min(output, self.max), self.min)

# 192. Task Scheduler (Pseudo-RTOS)
# Clean way to run 100Hz, 10Hz, 1Hz loops.
class TaskScheduler:
    def __init__(self, main_freq_hz=100):
        self.period = 1.0 / main_freq_hz
        self.tasks = []
        self.tick = 0

    def add_task(self, func, divider):
        """Run 'func' every 'divider' ticks"""
        self.tasks.append({"func": func, "div": divider})

    def run(self):
        # Master Loop
        start = time.monotonic()
        
        for task in self.tasks:
            if self.tick % task['div'] == 0:
                task['func']()
        
        self.tick += 1
        
        # Sleep remainder
        elapsed = time.monotonic() - start
        sleep_time = self.period - elapsed
        if sleep_time > 0: time.sleep(sleep_time)

# 193. Simple State Machine (Class Based)
class StateMachine:
    def __init__(self):
        self.state = "IDLE"
        self.handlers = {}

    def add_state(self, name, handler_func):
        self.handlers[name] = handler_func

    def set_state(self, new_state):
        if new_state in self.handlers:
            print(f"[FSM] {self.state} -> {new_state}")
            self.state = new_state
            
    def update(self):
        if self.state in self.handlers:
            # Execute current state logic
            self.handlers[self.state]()

# 194. Watchdog Timer (Software)
# If feed() isn't called for X seconds, trigger callback (e.g., land drone).
class Watchdog:
    def __init__(self, timeout, callback):
        self.timeout = timeout
        self.cb = callback
        self.last_feed = time.time()
        
    def feed(self):
        self.last_feed = time.time()
        
    def check(self):
        if time.time() - self.last_feed > self.timeout:
            self.cb() # Trigger failsafe

# 195. Math Utils (Static Module)
# Common robotics functions.
class MathUtils:
    @staticmethod
    def map_range(x, in_min, in_max, out_min, out_max):
        return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min

    @staticmethod
    def deadband(value, threshold):
        if abs(value) < threshold: return 0
        return value

    @staticmethod
    def constrain(val, min_val, max_val):
        return max(min(val, max_val), min_val)

# 196. Button Manager (Debounce + Click)
# Handles messy physical buttons.
class ButtonHandler:
    def __init__(self, pin_obj):
        self.btn = pin_obj # gpiozero Button
        self.btn.when_pressed = self._press
        self.btn.when_released = self._release
        self.last_press = 0
        self.callback = None

    def _press(self):
        self.last_press = time.time()

    def _release(self):
        duration = time.time() - self.last_press
        if duration < 0.05: return # Debounce junk
        if self.callback:
            if duration > 1.0: self.callback("LONG")
            else: self.callback("SHORT")

    def set_callback(self, func):
        self.callback = func

# 197. Performance Monitor (CPU & Loop Time)
# Check if your code is running too slow.
class PerfMonitor:
    def __init__(self):
        self.start = time.monotonic()
        self.max_dt = 0
    
    def mark_start(self):
        self.start = time.monotonic()
        
    def mark_end(self):
        dt = time.monotonic() - self.start
        if dt > self.max_dt: self.max_dt = dt
        return dt # Returns execution time in seconds

# 198. CLI Parser (Serial Command Line)
# Simple way to type commands: "SET PID 1.0 0.1 0"
class CLI:
    def __init__(self):
        self.commands = {}
        
    def register(self, cmd_name, func):
        self.commands[cmd_name] = func
        
    def parse_input(self, line):
        parts = line.strip().upper().split()
        if not parts: return
        
        cmd = parts[0]
        args = parts[1:]
        
        if cmd in self.commands:
            try:
                self.commands[cmd](args)
            except Exception as e:
                print(f"CMD Error: {e}")
        else:
            print("Unknown Command")

