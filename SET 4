# 186. Threaded CSV Logger (Non-Blocking)
# The industry standard way to log data.
class AsyncLogger:
    def __init__(self, filename="flight_log.csv"):
        self.queue = queue.Queue()
        self.filename = filename
        self.thread = threading.Thread(target=self._write_loop, daemon=True)
        self.thread.start()

    def log(self, data_list):
        """Call this from your high-speed loop"""
        # Add timestamp automatically
        self.queue.put([time.time()] + data_list)

    def _write_loop(self):
        with open(self.filename, 'a', newline='') as f:
            writer = csv.writer(f)
            while True:
                data = self.queue.get()
                writer.writerow(data)
                self.queue.task_done()
                f.flush() # Ensure data hits disk

# 187. Config Manager (JSON with Auto-Reload)
# Load settings once. Reload if file changes? Optional.
class Config:
    def __init__(self, path="config.json"):
        self.path = path
        self.data = self._load()
    
    def _load(self):
        defaults = {"pid": {"p": 1.0, "i": 0.0, "d": 0.0}, "loop_hz": 100}
        if not os.path.exists(self.path):
            with open(self.path, 'w') as f: json.dump(defaults, f, indent=4)
            return defaults
        try:
            with open(self.path, 'r') as f: return json.load(f)
        except:
            return defaults

    def get(self, key, subkey=None):
        """Safe getter. usage: cfg.get('pid', 'p')"""
        try:
            if subkey: return self.data[key][subkey]
            return self.data[key]
        except KeyError:
            return 0 # Safe default

# 188. Ring Buffer (Moving History)
# Keep last N samples (for averaging or crash dumps)
class HistoryBuffer:
    def __init__(self, size=100):
        self.buffer = deque(maxlen=size)
    
    def add(self, val):
        self.buffer.append(val)
        
    def get_average(self):
        if not self.buffer: return 0
        return sum(self.buffer) / len(self.buffer)
        
    def dump_to_file(self, filename):
        with open(filename, 'w') as f:
            for item in self.buffer:
                f.write(f"{item}\n")

# 189. Signal Filter Module (Low Pass)
# Smooth out jittery sensor data.
class LowPassFilter:
    def __init__(self, alpha=0.1):
        self.alpha = alpha
        self.prev = None

    def update(self, val):
        if self.prev is None:
            self.prev = val
            return val
        
        filtered = (self.alpha * val) + ((1.0 - self.alpha) * self.prev)
        self.prev = filtered
        return filtered

# 190. Rate Limiter (For Logs/Prints)
# "Print this error only once per second"
class RateLimiter:
    def __init__(self, interval_sec):
        self.interval = interval_sec
        self.last_time = 0

    def ready(self):
        now = time.monotonic()
        if now - self.last_time > self.interval:
            self.last_time = now
            return True
        return False

