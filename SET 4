# 181. The "RobustSerial" Class (The Ultimate UART Wrapper)
# Handles: Auto-Reconnection, Threading, Buffering, Line Parsing
class RobustSerial:
    def __init__(self, port, baud=9600):
        self.port = port
        self.baud = baud
        self.ser = None
        self.running = True
        self.rx_queue = queue.Queue()
        self.tx_queue = queue.Queue()
        
        # Start background thread
        self.thread = threading.Thread(target=self._worker, daemon=True)
        self.thread.start()

    def send(self, data_str):
        """Public API: Send a string (non-blocking)"""
        self.tx_queue.put(data_str)

    def read_line(self):
        """Public API: Get latest line or None"""
        try:
            return self.rx_queue.get_nowait()
        except queue.Empty:
            return None

    def _worker(self):
        while self.running:
            # 1. Connect
            if self.ser is None:
                try:
                    self.ser = serial.Serial(self.port, self.baud, timeout=1)
                    print(f"[Serial] Connected to {self.port}")
                except serial.SerialException:
                    time.sleep(1) # Wait before retry
                    continue

            # 2. IO Loop
            try:
                # Read
                if self.ser.in_waiting:
                    line = self.ser.readline().decode('utf-8', errors='ignore').strip()
                    if line: self.rx_queue.put(line)
                
                # Write
                while not self.tx_queue.empty():
                    msg = self.tx_queue.get_nowait()
                    self.ser.write(f"{msg}\n".encode())
                    
            except (serial.SerialException, OSError):
                print("[Serial] Connection Lost!")
                self.ser.close()
                self.ser = None # Trigger reconnect logic

# 182. CSV-Over-UART Parser (Incoming)
# Parses strings like: "START, 12.5, 0.05, 100, END" safely
class CSVParser:
    def __init__(self, expected_columns=3):
        self.cols = expected_columns

    def parse(self, raw_string):
        """Returns list of floats or None if invalid"""
        if not raw_string: return None
        
        # Remove whitespace and split
        parts = [p.strip() for p in raw_string.split(',')]
        
        # Validation 1: Length check
        if len(parts) != self.cols:
            return None
            
        # Validation 2: Type conversion
        try:
            return [float(x) for x in parts]
        except ValueError:
            return None # Contains non-numbers

# 183. CSV-Over-UART Sender (Outgoing)
# Formats data efficiently: "12.50,0.05,100"
def format_csv_packet(*args):
    """
    Usage: packet = format_csv_packet(temp, pressure, status)
    Output: "25.40,1013.2,1"
    """
    # Use f-string formatting for precision control
    # .2f = 2 decimal places (saves bandwidth)
    formatted = [f"{x:.2f}" if isinstance(x, float) else str(x) for x in args]
    return ",".join(formatted)

# 184. Binary Telemetry Packer (Struct Class)
# For high-speed UAV data (10x faster than CSV)
class TelemetryPacker:
    def __init__(self):
        # Format: Start(BB), 3 Floats(fff), Status(i), End(BB)
        self.fmt = '<BBfffiBB' 
        self.start_byte = 0xAA
        self.end_byte = 0x55

    def pack(self, roll, pitch, yaw, status):
        return struct.pack(self.fmt, 
                           self.start_byte, self.start_byte,
                           roll, pitch, yaw, status,
                           self.end_byte, self.end_byte)

    def unpack(self, data_bytes):
        try:
            unpacked = struct.unpack(self.fmt, data_bytes)
            # Return just the data (strip headers)
            return unpacked[2:6] 
        except struct.error:
            return None

# 185. The "Message Bus" (Internal Pub/Sub)
# Decouples your modules. "Sensor" doesn't need to know "Logger" exists.
class MessageBus:
    def __init__(self):
        self.subscribers = {}

    def subscribe(self, topic, callback):
        if topic not in self.subscribers:
            self.subscribers[topic] = []
        self.subscribers[topic].append(callback)

    def publish(self, topic, data):
        if topic in self.subscribers:
            for callback in self.subscribers[topic]:
                callback(data)

