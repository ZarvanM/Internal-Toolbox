# 90. Drift-Free Loop Class
class RateLimiter:
    def __init__(self, hz):
        self.period = 1.0/hz
        self.next = time.monotonic()
    def sleep(self):
        now = time.monotonic()
        sleep = self.next - now
        if sleep > 0: time.sleep(sleep); self.next += self.period
        else: self.next = now + self.period

