# 141. Modbus CRC16 Calculation (Crucial for VFDs)
# The standard checksum used by Delta MS300/Industrial gear.
def modbus_crc(data: bytes) -> bytes:
    crc = 0xFFFF
    for byte in data:
        crc ^= byte
        for _ in range(8):
            if crc & 1:
                crc = (crc >> 1) ^ 0xA001
            else:
                crc >>= 1
    # Returns Low Byte, High Byte (Little Endian)
    return struct.pack('<H', crc)

# 142. Constructing a Modbus RTU Packet
# Example: Read Status (Func 03) from Slave 1, Reg 0x2000, 1 Word
def build_modbus_read(slave_id, reg_addr, count):
    # ID, Func, RegHi, RegLo, CntHi, CntLo
    payload = struct.pack('>BBHH', slave_id, 3, reg_addr, count)
    crc = modbus_crc(payload)
    return payload + crc

