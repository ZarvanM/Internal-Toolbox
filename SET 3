# 151. Slew Rate Limiter (Soft Start)
# Prevents motor from jumping 0->100% instantly (saves gears).
current_out = 0.0
def slew_limit(target, max_change):
    global current_out
    change = target - current_out
    # Clamp change to +/- max_change
    if change > max_change: change = max_change
    if change < -max_change: change = -max_change
    current_out += change
    return current_out

# 152. Map Function (Arduino Style)
def map_range(x, in_min, in_max, out_min, out_max):
    return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min

# 153. Clamp / Constrain
def clamp(n, minn, maxn):
    return max(min(maxn, n), minn)

# 154. Deadband Filter
# Ignore joystick drift near center.
def deadband(val, threshold=0.05):
    if abs(val) < threshold: return 0.0
    return val

# 155. Exponential Moving Average (EMA)
# Very fast Low-Pass Filter. Alpha 0.1 = Slow, 0.9 = Fast.
ema_val = 0
def update_ema(new_sample, alpha=0.2):
    global ema_val
    ema_val = (alpha * new_sample) + ((1 - alpha) * ema_val)
    return ema_val

# 156. Derivator (Rate of Change)
# Good for detecting "Sudden Impact" (Crash).
prev_val = 0
def get_rate(new_val, dt):
    global prev_val
    rate = (new_val - prev_val) / dt
    prev_val = new_val
    return rate

# 157. Wrapping Angle (0-360 deg)
# Handles the jump from 359 to 0.
def diff_angle(a, b):
    d = a - b
    while d > 180: d -= 360
    while d <= -180: d += 360
    return d

# 158. Tank Drive Mixing (Steering)
# Convert Throttle/Steering to Left/Right Motor.
def arcade_drive(throttle, turn):
    left = throttle + turn
    right = throttle - turn
    return clamp(left, -1, 1), clamp(right, -1, 1)

# 159. Hysteresis Switch (Thermostat Logic)
# Prevents rapid toggling at threshold.
fan_on = False
def update_fan(temp):
    global fan_on
    if temp > 60: fan_on = True
    if temp < 55: fan_on = False
    return fan_on

